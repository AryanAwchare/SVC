# ==============================================================================
# Singing Voice Conversion Website - Environment Configuration
# ==============================================================================

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development
DEBUG=true

# Server Networking
API_HOST=127.0.0.1
API_PORT=8000
CLIENT_ORIGIN=http://localhost:3000

# GPU Execution Mode:
# 'true'  = Free local CPU development. Simulates conversion with pitch-shifted audio.
# 'false' = Dispatches inference to serverless Cloud GPU worker (Modal).
USE_MOCK_GPU=true

# Modal Cloud GPU Credentials (Required only when USE_MOCK_GPU=false)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=vocal-morph-gpu

# Storage Provider Configuration:
# 'local' writes to LOCAL_STORAGE_DIR.
# 's3' uses Cloudflare R2 or AWS S3 via pre-signed upload/download URLs.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./backend/storage_data

# Cloudflare R2 / AWS S3 Settings (Required only when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Security, Constraints & Privacy Guardrails
MAX_SONG_DURATION_SEC=360
MAX_SAMPLE_DURATION_SEC=60
JOB_RETENTION_HOURS=24
RATE_LIMIT_PER_HOUR=10
